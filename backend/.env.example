APP_NAME="Edi's Journal Store"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_URL=https://api-store.edisjournal.my.id

FRONTEND_URL=https://store.edisjournal.my.id

# Otentikasi sosial (Google) — isi SETELAH deploy (lihat docs/DEPLOY.md)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api-store.edisjournal.my.id/api/v1/auth/google/callback

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=store.edisjournal.my.id

# Akun admin (WAJIB diisi sebelum seed)
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# Pembayaran — iPaymu (sandbox/produksi lihat docs/PAYMENT-IPAYMU.md)
PAYMENT_DRIVER=ipaymu
IPAYMU_BASE_URL=https://sandbox.ipaymu.com/api/v2
IPAYMU_VA=
IPAYMU_API_KEY=
# Kosongkan untuk default {APP_URL}/api/v1/webhooks/ipaymu
IPAYMU_NOTIFY_URL=
IPAYMU_EXPIRED_HOURS=2

# Pengiriman (ongkir asli Mengantar)
SHIPPING_DRIVER=mengantar
MENGANTAR_API_KEY=
MENGANTAR_BASE_URL=https://app.mengantar.com
MENGANTAR_WEBHOOK_SECRET=
MENGANTAR_ORIGIN_ID=
MENGANTAR_PICKUP_ADDRESS_ID=
MENGANTAR_PICKUP_TIME_ID=
MENGANTAR_COURIERS=JNE,SiCepat,SAP,JT,anteraja,lion,pos,spx,iDexpress

# Email (untuk lupa password & verifikasi email) — isi dengan SMTP
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Edi's Journal Store"
